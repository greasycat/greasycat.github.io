---
const { frontmatter } = Astro.props;
const readtime = frontmatter.readtime ? frontmatter.readtime + " min" : "Unknown";
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title}</title>
    <style is:global>
      body {
        margin: 0;
        padding: 0;
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: #333;
        background-color: #fafafa;
      }
      
      blockquote {
        background-color: #f0f0f0;
        border: 1px solid #e0e0e0;
        padding-left: 1rem;
      }

      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
        padding-top: 1rem;
        background-color: white;
        min-height: 100vh;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        position: relative;
      }

      .nav {
        display: flex;
        justify-content:center;
        align-items: center;
      }

      .back-button {
        color: inherit;
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        font-weight: 600;
      }
      

      /* code blocks */
      .astro-code {
        border: 1px solid #e0e0e0;
        padding: 1rem;
      }

      .meta {
        font-size: 0.8rem;
        color: #666;

        margin-top: 1rem;
        margin-bottom: 1rem;

        width: 100%;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
      }

      .readtime {
        margin-left: 1rem;
      }

      .date {
        margin-right: 1rem;
      }

      /* inline code */
      p > code {
        background-color: #f0f0f0;
      }


      /* Mobile Responsive Styles */
      @media (max-width: 768px) {
        body {
          font-size: 16px;
          line-height: 1.6;
        }
        
        .container {
          margin: 0;
          padding: 1rem;
          min-height: 100vh;
          box-shadow: none;
          border-radius: 0;
        }
        
        .back-button {
          margin-bottom: 1.5rem;
        }

        /* Improve readability on mobile */
        h1, h2, h3, h4, h5, h6 {
          line-height: 1.3;
          margin-top: 1.5rem;
          margin-bottom: 0.75rem;
        }

        h1 { font-size: 1.75rem; }
        h2 { font-size: 1.5rem; }
        h3 { font-size: 1.25rem; }
        h4 { font-size: 1.125rem; }

        p {
          margin-bottom: 1rem;
        }

        /* Better spacing for lists */
        ul, ol {
          padding-left: 1.5rem;
          margin-bottom: 1rem;
        }

        li {
          margin-bottom: 0.5rem;
        }

        /* Improve blockquote on mobile */
        blockquote {
          margin: 1rem 0;
          padding: 1rem;
          border-left: 4px solid #007acc;
          background-color: #f8f9fa;
        }

        /* Better code blocks on mobile */
        pre {
          overflow-x: auto;
          padding: 1rem;
          background-color: #f8f9fa;
          border-radius: 6px;
          font-size: 14px;
          line-height: 1.4;
        }

        code {
          font-size: 14px;
          padding: 0.2rem 0.4rem;
        }

        /* Improve table readability on mobile */
        table {
          width: 100%;
          overflow-x: auto;
          display: block;
          font-size: 14px;
        }

        th, td {
          padding: 0.5rem;
          text-align: left;
          border-bottom: 1px solid #e0e0e0;
        }

        /* Better image handling on mobile */
        img {
          max-width: 100%;
          height: auto;
          border-radius: 6px;
          margin: 1rem 0;
        }

        /* Improve link visibility on mobile */
        a {
          color: #007acc;
          text-decoration: underline;
        }

        a:hover {
          color: #005a9e;
        }
      }

      /* Small mobile devices */
      @media (max-width: 480px) {
        .container {
          padding: 0.75rem;
        }

        h1 { font-size: 1.5rem; }
        h2 { font-size: 1.25rem; }
        h3 { font-size: 1.125rem; }
      }

      @font-face {
        font-family: "Inter";
        src: url("/fonts/Inter.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="nav">
        <a href="/" class="back-button">
          Home
        </a>
      </div>
      <div class="meta">
        <div class="readtime">
          ETA: {readtime}
        </div>
        <div class="title">
          {frontmatter.title}
        </div>
        <div class="date">
          {new Date(frontmatter.date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'})}
        </div>
      </div>
      <slot />
    </div>
  </body>
</html>
