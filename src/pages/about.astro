---
import gitBranchIcon from "lucide-static/icons/git-branch.svg?url";

type Project = {
  name: string;
  summary: string;
  url?: string;
  skills: string[];
};

const skillId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const devProjects: Project[] = [
  {
    name: "Onemoon",
    url: "https://github.com/greasycat/onemoon",
    summary:
      "Note-to-LaTeX conversion for handwritten notes, screenshots, and PDFs.",
    skills: ["Python", "LaTeX / Typst automation", "CLI / terminal"],
  },
  {
    name: "Pactrack",
    url: "https://github.com/greasycat/pactrack",
    summary: "Arch Linux package update tracker with a tray icon and menu.",
    skills: ["Rust", "CLI / terminal"],
  },
  {
    name: "Wkey",
    url: "https://github.com/greasycat/wkey",
    summary:
      "Terminal-first cheatsheet for keyboard shortcuts and working notes.",
    skills: ["Rust", "CLI / terminal"],
  },
  {
    name: "BetterMathjax",
    url: "https://github.com/greasycat/BetterMathjax",
    summary: "MathJax autocompletion for Obsidian.",
    skills: ["Python", "Obsidian plugin tooling"],
  },
];

const researchProjects: Project[] = [
  {
    name: "MorphoCLIP",
    url: "https://morphoclip.suxrobgm.net/",
    summary:
      "Representation learning on multi-channel drug-perturbated cell images",
    skills: ["Python", "Machine learning", "Representation learning", "Computer vision"],
  },
  {
    name: "LandmarksR",
    url: "https://github.com/greasycat/LandmarksR",
    summary:
    "Unity-base Spatial Cognition experiment framework with Meta Quest support",
    skills: ["C#", "Unity / Meta Quest / Steam VR", "Spatial Cognition Experiment / Analysis"],
  },
  {
    name: "ADHD Classification",
    url: "https://github.com/greasycat/adhd_prediction",
    summary:
      "fMRI ADHD classification with functional connectivity features and joint models",
    skills: ["Python", "R", "Machine learning", "fMRI analysis"],
  },
  {
    name: "SandBox Marker",
    url: "https://github.com/greasycat/sandbox_marker",
    summary:
    "Real-time dual-camera image registration with Unity integration for Mixed Reality Sandbox",
    skills: ["Python", "C#", "Computer vision", "Unity / Meta Quest / Steam VR"],
  },
];

const programmingLanguages = ["Python", "R", "C#", "Rust", "Bash"];

const otherSkills = [
  "Machine learning",
  "Computer vision",
  "Unity / Meta Quest / Steam VR",
  "Spatial Cognition Experiment / Analysis",
  "fMRI analysis",
  "CLI / terminal",
  "Docker"
];

const profile = {
  name: "Rongfei Jin",
  handle: "@greasycat",
  githubUrl: "https://github.com/greasycat",
};

const title = `${profile.name} / Portfolio`;
const description = "Minimal portfolio.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      @font-face {
        font-family: "Inter";
        src: url("/fonts/Inter.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --ink: #2c3e50;
        --muted: #667085;
        --line: #dfe3e8;
        --soft: #f7f8fa;
        --paper: #ffffff;
      }

      html {
        background: var(--paper);
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--ink);
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem;
        min-height: 100vh;
        background: var(--paper);
      }

      main {
        display: grid;
        gap: 3rem;
      }

      section {
        display: grid;
        gap: 1rem;
      }

      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0;
      }

      .hero {
        padding-top: 1rem;
        border-bottom: 2px dotted var(--line);
        padding-bottom: 2rem;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.5rem;
        align-items: center;
      }

      .hero-copy {
        display: grid;
        gap: 1rem;
      }

      .hero h1 {
        font-size: clamp(2rem, 6vw, 3.5rem);
        line-height: 1.05;
        margin: 0;
        color: var(--ink);
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .hero p {
        max-width: 38rem;
        margin: 0;
        color: #4b5563;
      }

      .hero-links,
      .meta-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .hero-links a,
      .project-title-link {
        color: inherit;
        text-decoration: none;
      }

      .hero-links a {
        border-bottom: 1px solid var(--ink);
      }

      .hero-links .icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-bottom: 0;
        line-height: 0;
      }

      .hero-links .icon-link img {
        width: 18px;
        height: 18px;
        display: block;
      }

      .hero-eye {
        justify-self: end;
        width: clamp(150px, 22vw, 220px);
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 999px;
      }

      .hero-eye img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        transform: scale(1.5);
      }

      .split {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
        gap: 2rem;
        align-items: start;
      }

      .note {
        background: var(--soft);
        border: 1px solid var(--line);
        padding: 1.25rem;
      }

      .note p,
      .project-card p {
        margin: 0;
      }

      .section-title {
        font-size: 1.35rem;
        font-weight: 600;
        margin: 0;
      }

      .section-copy {
        color: #4b5563;
        max-width: 40rem;
      }

      .project-card {
        padding: 0;
      }

      .projects-grid {
        display: grid;
        gap: 1.25rem;
      }

      .project-group {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }

      .project-group-title {
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1;
        margin: 0;
        padding: 0;
      }

      .project-list {
        display: grid;
        gap: 0.45rem;
        align-self: start;
      }

      .project-line {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        min-width: 0;
      }

      .project-name {
        font-size: 1rem;
        font-weight: 600;
        white-space: nowrap;
        line-height: 1.1;
      }

      .project-title-link:hover,
      .project-title-link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.14em;
      }

      .project-summary {
        color: #4b5563;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.1;
      }

      .skills-grid {
        display: grid;
        gap: 1.25rem;
      }

      .skill-group {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }

      .skill-group-title {
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1;
        margin: 0;
        padding: 0;
      }

      .skill-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
      }

      .skill-list li {
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: #4b5563;
        font-size: 0.95rem;
        line-height: 1.3;
        transition:
          background-color 120ms ease,
          border-color 120ms ease,
          color 120ms ease,
          transform 120ms ease;
      }

      .skill-list li.is-related {
        background: var(--soft);
        border-color: var(--ink);
        color: var(--ink);
        transform: translateY(-1px);
      }

      .footer {
        padding-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 768px) {
        body {
          padding: 1.25rem;
        }

        main {
          gap: 2.5rem;
        }

        .split {
          grid-template-columns: 1fr;
        }

        .hero-grid {
          grid-template-columns: 1fr;
        }

        .hero-eye {
          justify-self: start;
          width: min(100%, 240px);
        }

        .project-line,
        .footer {
          grid-template-columns: 1fr;
          display: grid;
        }

        .project-group {
          grid-template-columns: 1fr;
        }

        .skill-group {
          grid-template-columns: 1fr;
        }

        .project-summary {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{profile.handle}</p>
            <h1>{profile.name}</h1>
            <div class="hero-links">
              <a class="icon-link" href={profile.githubUrl} aria-label="GitHub">
                  <img src={gitBranchIcon} alt="" />
                  <p>GitHub</p>
              </a>
            </div>
          </div>
          <div class="hero-eye">
            <img
              src="/images/profile.png"
              alt="Profile photo"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <section class="split">
        <div>
          <p class="eyebrow">About</p>
          <p class="section-copy">
          Hi there! <br> Rongfei here (also go by Eric). <br>
          <br>
          I love coding, cooking and...<br> ... cat-sitting my little friend Loopa.
          </p>
        </div>
        <aside class="note">
          <p class="eyebrow">Current focus</p>
          <p>
          Migrating from MS to PhD<br> 
          <br> Visual Perception/Image Generation <br> Cognition Modeling

          </p>
        </aside>
      </section>

      <section id="projects">
        <p class="eyebrow">Projects</p>
        <div class="projects-grid">
          <div class="project-group">
            <h2 class="project-group-title">Dev</h2>
            <div class="project-list">
              {
                devProjects.map((project) => (
                  <div
                    class="project-card"
                    data-project-skills={project.skills.map((skill) => skillId(skill)).join(" ")}
                  >
                    <div class="project-line">
                      {project.url ? (
                        <a class="project-title-link project-name" href={project.url}>
                          {project.name}
                        </a>
                      ) : (
                        <span class="project-name">{project.name}</span>
                      )}
                      <span class="project-summary">{project.summary}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="project-group">
            <h2 class="project-group-title">Research</h2>
            <div class="project-list">
              {
                researchProjects.map((project) => (
                  <div
                    class="project-card"
                    data-project-skills={project.skills.map((skill) => skillId(skill)).join(" ")}
                  >
                    <div class="project-line">
                      {project.url ? (
                        <a class="project-title-link project-name" href={project.url}>
                          {project.name}
                        </a>
                      ) : (
                        <span class="project-name">{project.name}</span>
                      )}
                      <span class="project-summary">{project.summary}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="skills">
        <p class="eyebrow">Skills</p>
        <div class="skills-grid">
          <div class="skill-group">
            <h2 class="skill-group-title">Languages</h2>
            <ul class="skill-list">
              {programmingLanguages.map((language) => (
                <li data-skill-id={skillId(language)}>{language}</li>
              ))}
            </ul>
          </div>

          <div class="skill-group">
            <h2 class="skill-group-title">Other</h2>
            <ul class="skill-list">
              {otherSkills.map((skill) => <li data-skill-id={skillId(skill)}>{skill}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <script is:inline>
        const skillItems = Array.from(document.querySelectorAll("[data-skill-id]"));
        const projectCards = Array.from(document.querySelectorAll("[data-project-skills]"));

        const clearRelatedSkills = () => {
          for (const item of skillItems) {
            item.classList.remove("is-related");
          }
        };

        const accentRelatedSkills = (skillIds) => {
          clearRelatedSkills();
          for (const item of skillItems) {
            if (skillIds.includes(item.dataset.skillId)) {
              item.classList.add("is-related");
            }
          }
        };

        for (const card of projectCards) {
          const skillIds = (card.getAttribute("data-project-skills") || "")
            .split(" ")
            .filter(Boolean);

          card.addEventListener("mouseenter", () => accentRelatedSkills(skillIds));
          card.addEventListener("mouseleave", clearRelatedSkills);
          card.addEventListener("focusin", () => accentRelatedSkills(skillIds));
          card.addEventListener("focusout", (event) => {
            if (!card.contains(event.relatedTarget)) {
              clearRelatedSkills();
            }
          });
        }
      </script>

      <footer class="footer">
      </footer>
    </main>
  </body>
</html>
