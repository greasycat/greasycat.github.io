---
type Post = {
  url: string;
  frontmatter: {
    title: string;
    date: string;
  };
};

const posts = (
  Object.values(import.meta.glob("./posts/*.md", { eager: true })) as Post[]
).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);

const postsByYear = posts.reduce(
  (acc, post) => {
    const year = new Date(post.frontmatter.date).getUTCFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, Post[]>
);

const title = "Flow";
const description = "by Greasycat";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Writing archive by Greasycat." />
    <title>{title}</title>
    <style>
      @font-face {
        font-family: "Inter";
        src: url("/fonts/Inter.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: #333;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        min-height: 100vh;
        background-color: #fff;
      }

      .title {
        font-size: 2rem;
        font-weight: 600;
        color: #2c3e50;
        text-align: center;
        margin-bottom: 0;
      }

      .description {
        font-size: 0.8rem;
        color: #666;
        margin-top: 0;
        margin-bottom: 1rem;
        text-align: center;
      }

      .posts {
        margin-top: 2rem;
      }

      .year-section {
        margin-bottom: 3rem;
      }

      .year-header {
        font-size: 1.5rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 1rem;
        border-bottom: 2px dotted #e0e0e0;
        padding-bottom: 0.5rem;
      }

      .date {
        font-size: 0.8rem;
        color: #666;
      }

      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #2c3e50;
      }

      p {
        margin-bottom: 1rem;
      }

      ul {
        list-style: none;
        padding: 0;
        padding-left: 1rem;
      }

      li {
        margin-bottom: 0.75rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }

      a {
        color: inherit;
        text-decoration: none !important;
      }

      @media (max-width: 768px) {
        body {
          padding: 1rem;
        }

        h1 {
          font-size: 1.75rem;
        }

        .year-header {
          font-size: 1.25rem;
        }
      }
    </style>
  </head>
  <body>
    <h1 class="title">{title}</h1>
    <p class="description">{description}</p>

    <div class="posts">
      {
        Object.entries(postsByYear)
          .sort(([a], [b]) => parseInt(b) - parseInt(a))
          .map(([year, yearPosts]) => (
            <div class="year-section">
              <h2 class="year-header">{year}</h2>
              <ul>
                {
                  yearPosts.map((post) => (
                    <li>
                      <a href={post.url}>{post.frontmatter.title}</a>
                      <span class="date">
                        {new Date(post.frontmatter.date).toLocaleString("en-US", {
                          month: "short",
                          timeZone: "UTC",
                        })}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
      }
    </div>
  </body>
</html>
